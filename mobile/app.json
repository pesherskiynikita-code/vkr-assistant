{
  "expo": {
    "name": "X2 Helpdesk",
    "slug": "x2-helpdesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/x2-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.x2groups.helpdesk"
    },
    "android": {
      "package": "com.x2groups.helpdesk",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/x2-android-foreground.png",
        "backgroundImage": "./assets/x2-android-background.png",
        "monochromeImage": "./assets/x2-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Микрофон нужен, чтобы надиктовать заявку голосом."
        }
      ],
      "expo-asset",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Камера нужна, чтобы сфотографировать проблему для заявки.",
          "photosPermission": "Доступ к фото нужен, чтобы прикрепить снимок к заявке."
        }
      ]
    ]
  }
}
